2f\u06cc\u06af\u0631 \u0634\u0631\u06cc\u06a9 \u06a9\u0627\u0631\u0648\u06ba \u06a9\u06d2 \u062f\u0648\u0628\u0627\u0631\u06c1 \u0633\u0627\u0626\u0679 \u067e\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u062d\u0641\u0648\u0638 \u06a9\u0631\u06cc\u06ba\u06d4 \u0627\u0633 \u0628\u0644\u0627\u06a9 \u0645\u06cc\u06ba \u06a9\u06cc \u06af\u0626\u06cc \u062a\u0628\u062f\u06cc\u0644\u06cc \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc \u06af\u0626\u06cc \u06c1\u0631 \u062c\u06af\u06c1 \u067e\u0631 \u062f\u06cc\u06a9\u06be\u06cc \u062c\u0627 \u0633\u06a9\u06d2 \u06af\u06cc\u06d4"],"Reusable Block":["\u062f\u0648\u0628\u0627\u0631\u06c1 \u0642\u0627\u0628\u0644 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0628\u0644\u0627\u06a9\u0633"],"Block has been deleted or is unavailable.":["\u0628\u0644\u0627\u06a9 \u062d\u0630\u0641 \u06a9\u0631\u062f\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u06d2 \u06cc\u0627 \u062f\u0633\u062a\u06cc\u0627\u0628 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4"],"Reusable Block: %s":["\u062f\u0648\u0628\u0627\u0631\u06c1 \u0642\u0627\u0628\u0644 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0628\u0644\u0627\u06a9\u0633: %s"],"Name:":["\u0646\u0627\u0645:"],"Solid Color":["\u0679\u06be\u0648\u0633 \u0631\u0646\u06af"],"Give special visual emphasis to a quote from your text.":["\u0627\u067e\u0646\u06d2 \u0679\u06cc\u06a9\u0633\u0679 \u0645\u06cc\u06ba \u0633\u06d2 \u06a9\u0633\u06cc \u06a9\u0648\u0679 \u06a9\u0648 \u0638\u0627\u06c1\u0631\u06cc \u0627\u06c1\u0645\u06cc\u062a \u062f\u06cc\u06ba\u06d4"],"Pullquote":["Pullquote"],"Main Color":["\u0645\u0631\u06a9\u0632\u06cc \u0631\u0646\u06af"],"Write preformatted text\u2026":["\u067e\u06c1\u0644\u06d2 \u0633\u06d2 \u067e\u06cc\u0634 \u06a9\u0631\u062f\u06c1 \u0637\u0631\u06cc\u0642\u06d2 \u0633\u06d2 \u062a\u062d\u0631\u06cc\u0631 \u0644\u06a9\u06be\u06cc\u06ba\u06d4\u06d4\u06d4"],"Add text that respects your spacing and tabs, and also allows styling.":["\u0645\u062a\u0646 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba \u062c\u0648 \u0622\u067e \u06a9\u06cc \u062e\u0644\u0627\u0621 \u0627\u0648\u0631 \u0679\u06cc\u0628 \u06a9\u0627 \u0627\u062d\u062a\u0631\u0627\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u060c \u0627\u0648\u0631 \u0627\u0633\u0679\u0627\u0626\u0644 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u062a\u0627 \u06c1\u06d2."],"Preformatted":["\u0648\u0636\u0639 \u0634\u062f\u06c1"],"pagination":["\u0635\u0641\u062d\u06c1 \u0628\u0646\u062f\u06cc"],"next page":["\u0627\u06af\u0644\u0627 \u0635\u0641\u062d\u06c1"],"Separate your content into a multi-page experience.":["\u0627\u067e\u0646\u06d2 \u06a9\u0627\u0646\u0679\u06cc\u0646\u0679 \u06a9\u0648 \u0627\u06cc\u06a9 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0635\u0641\u062d\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0644\u06af \u06a9\u0631\u06cc\u06ba\u06d4"],"Page Break":["\u067e\u06cc\u062c \u0628\u0631\u06cc\u06a9"],"Mark the excerpt of this content. Content before this block will be shown in the excerpt on your archives page.":["\u0645\u0648\u0627\u062f \u06a9\u06d2 \u062e\u0644\u0627\u0635\u06d2 \u06a9\u0627 \u0646\u0634\u0627\u0646 \u0644\u06af\u0627\u0626\u06cc\u06ba\u06d4 \u0627\u0633 \u0646\u0634\u0627\u0646 \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u06a9\u0627 \u062d\u0635\u06c1 \u062e\u0644\u0627\u0635\u06d2 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0622\u0631\u06a9\u0627\u0626\u06cc\u0648 \u067e\u0631 \u062f\u06a9\u06be\u06d2 \u06af\u0627\u06d4"],"block name\u0004More":["\u0645\u0632\u06cc\u062f"],"Hide the teaser before the \"More\" tag":["\"\u0645\u0632\u06cc\u062f\" \u0679\u06cc\u06af \u0633\u06d2 \u067e\u06c1\u0644\u06d2 \u0679\u06cc\u0632\u0631\u06a9\u0648 \u0686\u06be\u067e\u0627\u0626\u06cc\u06ba"],"Read more":["\u0645\u0632\u06cc\u062f \u067e\u0691\u06be\u06cc\u06ba"],"Your site doesn\u2019t include support for this block.":[" \u0627\u0653 \u067e \u06a9\u06cc \u0633\u0627\u0626\u0679 \u067e\u0631 \u0627\u0633 \u0628\u0644\u0627\u06a9 \u06a9\u06cc \u0633\u067e\u0648\u0631\u0679 \u0645\u0648\u062c\u0648\u062f \u0646\u06c1\u06cc\u06ba\u06d4"],"Unrecognized Block":["\u06cc\u06c1 \u0628\u0644\u0627\u06a9 \u067e\u06c1\u0686\u0627\u0646 \u0645\u06cc\u06ba \u0646\u06c1\u06cc\u06ba \u0627\u0653\u0631\u06c1\u0627"],"Your site doesn\u2019t include support for the \"%s\" block. You can leave this block intact or remove it entirely.":["\u0627\u0653 \u067e \u06a9\u06d2 \u0633\u0627\u0626\u0679 \"%s\" \u0628\u0644\u0627\u06a9 \u06a9\u0648 \u0633\u067e\u0648\u0631\u0679 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u06cc\u06d4 \u06cc\u0627 \u0627\u0633 \u06a9\u0648 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0646\u06c1 \u06a9\u0631\u06cc\u06ba \u06cc\u0627 \u0627\u0633 \u06a9\u0648 \u0688\u06cc\u0644\u06cc\u0679 \u06a9\u0631 \u062f\u06cc\u06ba\u06d4"],"Keep as HTML":["HTML \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u0631\u06a9\u06be\u06cc\u06ba"],"Your site doesn\u2019t include support for the \"%s\" block. You can leave this block intact, convert its content to a Custom HTML block, or remove it entirely.":["\u0627\u0653\u067e \u06a9\u06cc \u0633\u0627\u0626\u0679 \u0645\u06cc\u06ba \"%s\" \u0628\u0644\u0627\u06a9 \u06a9\u06cc \u0633\u067e\u0648\u0631\u0679 \u0646\u06c1\u06cc\u06ba\u06d4 \u06cc\u0627 \u0627\u0633 \u06a9\u0648 \u0627\u06cc\u0633\u06d2 \u0631\u06c1\u0646\u06d2 \u062f\u06cc\u06ba\u060c \u06cc\u0627 \u0627\u06cc\u0686 \u0679\u06cc \u0627\u06cc\u0645 \u0627\u06cc\u0644 \u0645\u06cc\u06ba \u06a9\u0646\u0648\u0631\u0679 \u06a9\u0631\u06cc\u06ba\u060c \u06cc\u0627 \u0627\u0633 \u06a9\u0648 \u0688\u06cc\u0644\u06cc\u0679 \u06a9\u0631 \u062f\u06cc\u06ba\u06d4"],"Write list\u2026":["\u0641\u06c1\u0631\u0633\u062a \u0644\u06a9\u06be\u06cc\u06ba\u06d4\u06d4\u06d4"],"numbered list":["\u0646\u0645\u0628\u0631 \u0648\u0627\u0644\u06cc \u0641\u06c1\u0631\u0633\u062a"],"ordered list":["\u062a\u0631\u062a\u06cc\u0628 \u0634\u062f\u06c1 \u0641\u06c1\u0631\u0633\u062a"],"bullet list":["\u0628\u0648\u0644\u06cc\u0679 \u0641\u06c1\u0631\u0633\u062a"],"Create a bulleted or numbered list.":["\u0646\u0645\u0628\u0631 \u06a9\u06cc \u06cc\u0627 \u0628\u0644\u0679 \u06a9\u06cc \u0644\u0633\u0679 \u0628\u0646\u0627\u0626\u06cc\u06ba"],"List":["\u0641\u06c1\u0631\u0633\u062a"],"recent posts":["\u062d\u0627\u0644 \u06c1\u06cc \u0645\u06cc\u06ba \u06a9\u06cc \u062c\u0627\u0646\u06d2 \u0648\u0627\u0644\u06cc \u067e\u0648\u0633\u0679\u0633 "],"Display a list of your most recent posts.":["\u0627\u067e\u0646\u06cc \u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u067e\u0648\u0633\u0679 \u06a9\u06cc \u0641\u06c1\u0631\u0633\u062a \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u06d4"],"Latest Posts":["\u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u067e\u0648\u0633\u0679"],"Display post date":["\u067e\u0648\u0633\u0679 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba"],"Latest Posts Settings":["\u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u067e\u0648\u0633\u0679 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"recent comments":["\u062d\u0627\u0644\u06cc\u06c1 \u062a\u0628\u0635\u0631\u06d2"],"Display a list of your most recent comments.":["\u062d\u0627\u0644\u06cc\u06c1 \u062a\u0628\u0635\u0631\u0648\u06ba \u06a9\u06cc \u0641\u06c1\u0631\u0633\u062a \u0634\u0648 \u06a9\u0631\u06cc\u06ba"],"Latest Comments":["\u062d\u0627\u0644\u06cc\u06c1 \u062a\u0628\u0635\u0631\u06d2"],"Number of Comments":["\u062a\u0628\u0635\u0631\u0648\u06ba \u06a9\u06cc \u062a\u0639\u062f\u0627\u062f"],"Display Excerpt":["\u062e\u0644\u0627\u0635\u06c1 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba"],"Display Date":["\u062a\u0627\u0631\u06cc\u062e \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba"],"Display Avatar":["\u0627\u0648\u0627\u0679\u0627\u0631 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba"],"Latest Comments Settings":["\u062a\u0627\u0632\u06c1 \u062a\u0631\u06cc\u0646 \u062a\u0628\u0635\u0631\u0648\u06ba \u06a9\u06cc \u0633\u06cc\u0679\u0646\u06af"],"Set media and words side-by-side for a richer layout.":["\u0628\u06c1\u062a\u0631 \u0644\u06d2 \u0627\u0653\u0648\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u06cc\u0688\u06cc\u0627 \u06a9\u0648 \u0633\u0627\u0626\u06cc\u0688 \u0628\u0627\u0626\u06d2 \u0633\u0627\u0626\u06cc\u0688 \u0631\u06a9\u06be\u06cc\u06ba"],"Media & Text":["\u0645\u06cc\u0688\u06cc\u0627 \u0627\u0648\u0631 \u0645\u062a\u0646"],"Stack on mobile":["\u0645\u0648\u0628\u0627\u0626\u0644 \u067e\u0631 \u0633\u0679\u06cc\u06a9"],"Media & Text Settings":["\u0645\u06cc\u0688\u06cc\u0627 \u0627\u0648\u0631 \u0645\u062a\u0646 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"Show media on right":["\u0645\u06cc\u0688\u06cc\u06cc\u0627 \u06a9\u0648 \u062f\u0627\u0626\u06cc\u06ba \u062c\u0627\u0646\u0628 \u0634\u0648 \u06a9\u0631\u06cc\u06ba"],"Show media on left":["\u0645\u06cc\u0688\u06cc\u0627 \u06a9\u0648 \u0628\u0627\u0626\u06cc\u06ba \u062c\u0627\u0646\u0628 \u0634\u0648 \u06a9\u0631\u06cc\u06ba"],"content placeholder\u0004Content\u2026":["\u0645\u0648\u0627\u062f\u06d4\u06d4\u06d4"],"Media area":["\u0645\u06cc\u0688\u06cc\u0627 \u06a9\u06cc \u062c\u06af\u06c1"],"HTML":["HTML"],"Write HTML\u2026":[" HTML \u0644\u06a9\u06be\u06cc\u06ba"],"embed":["\u0627\u06cc\u0645\u0628\u06cc\u0688"],"Add custom HTML code and preview it as you edit.":["\u06a9\u0633\u0679\u0645 HTML \u06a9\u0648\u0688 \u0644\u06a9\u06be\u06cc\u06ba \u0627\u0648\u0631 \u0627\u06cc\u0688\u0679 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u0638\u0627\u06c1\u0631\u06cc \u062a\u0628\u062f\u06cc\u0644\u06cc\u0627\u06ba \u062f\u06cc\u06a9\u06be\u06cc\u06ba\u06d4"],"button label\u0004Download":["\u0688\u0627\u0624\u0646 \u0644\u0648\u0688"],"pdf":["\u067e\u06cc \u0688\u06cc \u0627\u06cc\u0641"],"document":["\u062f\u0633\u062a\u0627\u0648\u06cc\u0632"],"Add a link to a downloadable file.":["\u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u06cc \u0641\u0627\u0626\u0644 \u0645\u06cc\u06ba \u0644\u0646\u06a9 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"],"Copy URL":["\u06cc\u0648\u0622\u0631\u0627\u06cc\u0644 \u06a9\u0627\u067e\u06cc \u06a9\u0631\u06cc\u06ba"],"Write file name\u2026":["\u0641\u0627\u0626\u0644 \u06a9\u0627 \u0646\u0627\u0645 \u0644\u06a9\u06be\u06cc\u06ba\u06d4\u06d4\u06d4"],"Edit file":["\u0641\u0627\u0626\u0644 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u06cc\u06ba"],"Drag a file, upload a new one or select a file from your library.":["\u0641\u0627\u0626\u0644 \u0688\u0631\u06cc\u06af \u06a9\u0631\u06cc\u06ba\u060c \u0627\u06cc\u06a9 \u0646\u0626\u06cc \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba \u06cc\u0627 \u0627\u067e\u0646\u06cc \u0644\u0627\u0626\u0628\u0631\u06cc\u0631\u06cc \u0633\u06d2 \u0641\u0627\u0626\u0644 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4"],"Show Download Button":["\u0688\u0627\u0648\u0646\u0644\u0648\u0688 \u06a9\u0627 \u0628\u0679\u0646 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba"],"Download Button Settings":["\u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u0628\u0679\u0646 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"Text Link Settings":["\u0645\u062a\u0646 \u0644\u0646\u06a9 \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"The download button is hidden.":["\u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u0628\u0679\u0646 \u0686\u06be\u067e\u0627 \u06c1\u0648\u0627 \u06c1\u06d2\u06d4"],"The download button is visible.":["\u0688\u0627\u0624\u0646 \u0644\u0648\u0688 \u0628\u0679\u0646 \u0646\u0638\u0631 \u0622 \u0631\u06c1\u0627 \u06c1\u06d2\u06d4"],"Embed videos, images, tweets, audio, and other content from external sources.":["\u0628\u06cc\u0631\u0648\u0646\u06cc \u0630\u0631\u0627\u0626\u0639 \u0633\u06d2 \u0648\u06cc\u0688\u06cc\u0648\u0632\u060c \u062a\u0635\u0627\u0648\u06cc\u0631\u060c \u0679\u0648\u06cc\u0679\u0633\u060c \u0622\u0688\u06cc\u0648\u060c \u0627\u0648\u0631 \u062f\u06cc\u06af\u0631 \u0645\u0648\u0627\u062f \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"],"block title\u0004Embed":["\u0627\u06cc\u0645\u0628\u06cc\u0688"],"Add a block that displays content pulled from other sites, like Twitter, Instagram or YouTube.":["\u0627\u06cc\u06a9 \u0628\u0644\u0627\u06a9 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba \u062c\u0648 \u062f\u0648\u0633\u0631\u06cc \u0633\u0627\u0626\u0679\u0633 \u0633\u06d2 \u062d\u0627\u0635\u0644 \u06a9\u06cc\u0627 \u06af\u06cc\u0627 \u0645\u0648\u0627\u062f \u062f\u06a9\u06be\u0627\u0626\u06d2\u060c \u062c\u06cc\u0633\u0627 \u06a9\u06c1 \u0679\u0648\u06cc\u0679\u0631\u060c \u0627\u0646\u0633\u0679\u0627\u06af\u0631\u0627\u0645 \u06cc\u0627 \u06cc\u0648\u0679\u06cc\u0648\u0628"],"%s URL":["%s \u06cc\u0648\u0622\u0631\u0627\u06cc\u0644"],"This embed may not preserve its aspect ratio when the browser is resized.":["\u062c\u0628 \u0628\u0631\u0627\u0624\u0632\u0631 \u06a9\u0648 \u062f\u0648\u0628\u0627\u0631\u06c1 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u06cc\u06c1 \u0627\u06cc\u0645\u0628\u06cc\u0688 \u0627\u067e\u0646\u06cc \u062a\u0646\u0627\u0633\u0628\u06cc \u067e\u06c1\u0644\u0648 \u06a9\u0648 \u0645\u062d\u0641\u0648\u0638 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0633\u06a9\u062a\u0627\u06d4"],"This embed will preserve its aspect ratio when the browser is resized.":["\u062c\u0628 \u0628\u0631\u0627\u0624\u0632\u0631 \u06a9\u0648 \u062f\u0648\u0628\u0627\u0631\u06c1 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2 \u062a\u0648 \u06cc\u06c1 \u0627\u06cc\u0645\u0628\u06cc\u0688 \u0627\u067e\u0646\u06cc \u062a\u0646\u0627\u0633\u0628\u06cc \u067e\u06c1\u0644\u0648 \u06a9\u0648 \u0645\u062d\u0641\u0648\u0638 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0633\u06a9\u062a\u0627\u06d4"],"Sorry, we cannot preview this embedded content in the editor.":["\u0645\u0639\u0627\u0641 \u06a9\u06cc\u062c\u06cc\u06d2 \u06af\u0627\u060c \u06c1\u0645 \u0627\u06cc\u0688\u06cc\u0679\u0631 \u0645\u06cc\u06ba \u0627\u0633 \u0627\u06cc\u0645\u0628\u06cc\u0688 \u0634\u062f\u06c1 \u0645\u0648\u0627\u062f \u06a9\u0627 \u067e\u06cc\u0634 \u0645\u0646\u0638\u0631 \u0646\u06c1\u06cc\u06ba \u062f\u0650\u06a9\u06be\u0627 \u0633\u06a9\u062a\u06d2\u06d4"],"Embedded content from %s":["%s \u0633\u06d2 \u0627\u06cc\u0645\u0628\u06cc\u0688\u0688 \u0645\u0648\u0627\u062f"],"button label\u0004Convert to link":["\u0644\u0646\u06a9 \u0645\u06cc\u06ba \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631\u06cc\u06ba"],"button label\u0004Try again":["\u062f\u0648\u0628\u0627\u0631\u06c1 \u06a9\u0648\u0634\u0634 \u06a9\u0631\u06cc\u06ba"],"Sorry, we could not embed that content.":["\u0645\u0639\u0627\u0641 \u06a9\u06cc\u062c\u06cc\u06d2 \u06af\u0627\u060c \u06c1\u0645 \u0627\u0633 \u0645\u0648\u0627\u062f \u06a9\u0648 \u0627\u06cc\u0645\u0628\u06cc\u0688 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0633\u06a9\u062a\u06d2 \u062a\u06be\u06d2\u06d4"],"button label\u0004Embed":["\u0627\u06cc\u0645\u0628\u06cc\u0688"],"Enter URL to embed here\u2026":["\u06cc\u06c1\u0627\u06ba \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06cc\u0648\u0622\u0631\u0627\u06cc\u0644 \u062f\u0631\u062c \u06a9\u0631\u06cc\u06ba\u06d4\u06d4\u06d4"],"Embedding\u2026":["\u0627\u06cc\u0645\u0628\u06cc\u0688\u0646\u06af\u06d4\u06d4\u06d4"],"Resize for smaller devices":["\u0686\u06be\u0648\u0679\u06cc \u0688\u06cc\u0648\u0627\u0626\u0633\u0632 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0633\u0627\u0626\u0632 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u0631\u06cc\u06ba"],"Media Settings":["\u0645\u06cc\u0688\u06cc\u0627 \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"Edit URL":["\u06cc\u0648\u0622\u0631\u0627\u06cc\u0644 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u06cc\u06ba"],"Write title\u2026":["\u0639\u0646\u0648\u0627\u0646 \u0644\u06a9\u06be\u06cc\u06ba\u06d4\u06d4\u06d4"],"Drag an image or a video, upload a new one or select a file from your library.":["\u0627\u06cc\u06a9 \u062a\u0635\u0648\u06cc\u0631 \u06cc\u0627 \u0648\u06cc\u0688\u06cc\u0648 \u06a9\u0648 \u0688\u0631\u06cc\u06af \u06a9\u0631\u06cc\u06ba\u060c \u0627\u06cc\u06a9 \u0646\u0626\u06cc \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba \u06cc\u0627 \u0627\u067e\u0646\u06cc \u0644\u0627\u0626\u0628\u0631\u06cc\u0631\u06cc \u0633\u06d2 \u0641\u0627\u0626\u0644 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba\u06d4"],"Background Opacity":["\u067e\u0633 \u0645\u0646\u0638\u0631 \u06a9\u0627 \u062f\u06be\u0646\u062f\u0644\u0627\u067e\u0646"],"Overlay Color":["\u0627\u0648\u0648\u0631\u0644\u06d2 \u06a9\u0627 \u0631\u0646\u06af"],"Overlay":["\u0627\u0648\u0648\u0631\u0644\u06d2"],"Fixed Background":["\u0641\u06a9\u0633\u0688 \u067e\u0633 \u0645\u0646\u0638\u0631"],"Cover Settings":["\u06a9\u0648\u0631 \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"Edit media":["\u0645\u06cc\u0688\u06cc\u0627 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u06cc\u06ba"],"Add an image or video with a text overlay \u2014 great for headers.":["\u0645\u062a\u0646 \u0627\u0648\u0648\u0631\u0644\u06d2 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0627\u06cc\u06a9 \u062a\u0635\u0648\u06cc\u0631 \u06cc\u0627 \u0648\u06cc\u0688\u06cc\u0648 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba \u2014 \u06c1\u06cc\u0688\u0631 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0628\u06c1\u062a \u0627\u0686\u06be\u0627 \u06c1\u06d2\u06d4"],"Cover":["\u06a9\u0648\u0631"],"A single column within a columns block.":["\u0627\u06cc\u06a9 \u06a9\u0627\u0644\u0645\u06cc \u0628\u0644\u0627\u06a9 \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0627\u06cc\u06a9 \u06a9\u0627\u0644\u0645\u06d4"],"Column":["\u06a9\u0627\u0644\u0645"],"Add a block that displays content in multiple columns, then add whatever content blocks you\u2019d like.":["\u0627\u06cc\u06a9 \u0627\u06cc\u0633\u06d2 \u0628\u0644\u0627\u06a9 \u06a9\u0648 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba \u062c\u0648 \u0645\u062a\u0639\u062f\u062f \u06a9\u0627\u0644\u0645\u0648\u06ba \u0645\u06cc\u06ba \u0645\u0648\u0627\u062f \u062f\u06a9\u06be\u0627\u062a\u0627 \u06c1\u06d2\u060c \u067e\u06be\u0631 \u062c\u0648 \u06a9\u0686\u06be \u0628\u06be\u06cc \u0645\u0648\u0627\u062f \u06a9\u06d2 \u0628\u0644\u0627\u06a9\u0633 \u0622\u067e \u0686\u0627\u06c1\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"],"Display code snippets that respect your spacing and tabs.":["\u0688\u0633\u067e\u0644\u06d2 \u06a9\u0648\u0688 \u06a9\u06d2 \u0679\u06a9\u0691\u06d2 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba \u062c\u0648 \u0622\u067e \u06a9\u06cc \u062c\u06af\u06c1 \u0627\u0648\u0631 \u0679\u06cc\u0628 \u06a9\u0627 \u0627\u062d\u062a\u0631\u0627\u0645 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"],"Write code\u2026":["\u06a9\u0648\u0688 \u0644\u06a9\u06be\u06cc\u06ba\u06d4\u06d4\u06d4"],"Display a list of all categories.":["\u062a\u0645\u0627\u0645 \u0632\u0645\u0631\u06d2 \u06a9\u06cc \u0627\u06cc\u06a9 \u0641\u06c1\u0631\u0633\u062a \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u06d4"],"Show Hierarchy":["\u06c1\u06cc\u0631\u0627\u0631 \u06a9\u06cc \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba"],"Categories Settings":["\u0632\u0645\u0631\u06c1 \u062c\u0627\u062a \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"block style\u0004Squared":["\u0645\u0631\u0628\u0639"],"Outline":["\u0622\u0624\u0679 \u0644\u0627\u0626\u0646"],"block style\u0004Rounded":["\u06af\u0648\u0644"],"Prompt visitors to take action with a custom button.":["\u06a9\u0633\u0679\u0645 \u0628\u0679\u0646 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0648\u0632\u06cc\u0679\u0631\u0632 \u0641\u0648\u0631\u06cc \u0637\u0648\u0631 \u067e\u0631 \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u062a\u062c\u0648\u06cc\u0632 \u06a9\u0631\u06cc\u06ba\u06d4"],"Button":["\u0628\u0679\u0646"],"Add text\u2026":["\u0679\u06a9\u0633\u0679 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4\u06d4\u06d4"],"Embed a simple audio player.":["\u0627\u06cc\u06a9 \u0633\u0627\u062f\u06c1 \u0622\u0688\u06cc\u0648 \u067e\u0644\u06cc\u0626\u0631 \u06a9\u0648 \u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba\u06d4"],"Auto":["\u0622\u0679\u0648"],"Audio Settings":["\u0622\u0688\u06cc\u0648 \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"Edit audio":["\u0622\u0688\u06cc\u0648 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u06cc\u06ba"],"Display a monthly archive of your posts.":["\u0627\u067e\u0646\u06cc \u067e\u0648\u0633\u0679\u0648\u06ba \u06a9\u0627 \u0627\u06cc\u06a9 \u0645\u0627\u06c1\u0627\u0646\u06c1 \u0622\u0631\u06a9\u0627\u0626\u06cc\u0648 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba\u06d4"],"Show Post Counts":["\u067e\u0648\u0633\u0679\u0648\u06ba \u06a9\u06cc \u062a\u0639\u062f\u0627\u062f \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba"],"Display as Dropdown":["\u0688\u0631\u0627\u067e \u0688\u0627\u0624\u0646 \u06a9\u06d2 \u0637\u0648\u0631 \u067e\u0631 \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba"],"Archives Settings":["\u0645\u062d\u0641\u0648\u0638\u0627\u062a \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"photos":["\u062a\u0635\u0627\u0648\u06cc\u0631"],"images":["\u062a\u0635\u0627\u0648\u06cc\u0631"],"Display multiple images in a rich gallery.":["\u0627\u06cc\u06a9 \u0633\u06d2 \u0632\u0627\u0626\u062f \u062a\u0635\u0627\u0648\u06cc\u0631 \u06af\u06cc\u0644\u0631\u06cc \u0645\u06cc\u06ba \u062f\u06a9\u06be\u0627\u0626\u06cc\u06ba"],"Upload an image":["\u062a\u0635\u0648\u06cc\u0631 \u0627\u067e \u0644\u0648\u0688 \u06a9\u0631\u06cc\u06ba"],"Crop Images":["\u062a\u0635\u0627\u0648\u06cc\u0631 \u06a9\u0631\u0622\u067e \u06a9\u0631\u06cc\u06ba"],"Drag images, upload new ones or select files from your library.":["\u0688\u0631\u06cc\u06af \u06a9\u0631\u06a9\u06d2\u060c \u0627\u067e\u0644\u0648\u0688 \u06a9\u0631\u06a9\u06d2\u060c \u06cc\u0627 \u0627\u067e\u0646\u06cc \u0644\u0627\u0626\u0628\u0631\u06cc\u0631\u06cc\u0633\u06d2 \u062a\u0635\u0648\u06cc\u0631 \u0633\u0644\u06cc\u06a9\u0679 \u06a9\u0631\u06cc\u06ba\u06d4"],"Thumbnails are not cropped.":["\u062a\u06be\u0645\u0628 \u0646\u06cc\u0644 \u0643\u0627 \u0633\u0627\u0626\u0632 \u062a\u0628\u062f\u06cc\u0644 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u06af\u06cc\u0627\u06d4"],"Thumbnails are cropped to align.":["\u062a\u06be\u0645\u0628 \u0646\u06cc\u0644 \u0633\u06cc\u062f\u06be\u0627 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0633\u0627\u0626\u0632 \u062a\u0628\u062f\u06cc\u0644 \u06a9\u06cc\u0627 \u06af\u06cc\u0627\u06d4"],"Remove Image":["\u062a\u0635\u0648\u06cc\u0631 \u062d\u0630\u0641 \u06a9\u0631\u06cc\u06ba"],"Write citation\u2026":["\u062d\u0648\u0627\u0644\u06c1 \u0644\u06a9\u06be\u06cc\u06ba\u06d4\u06d4\u06d4"],"Write quote\u2026":["\u0642\u0648\u0644 \u0644\u06a9\u06be\u06cc\u06ba\u06d4\u06d4\u06d4"],"block style\u0004Large":["\u0628\u0691\u0627"],"block style\u0004Regular":["\u0631\u06cc\u06af\u0648\u0644\u0631"],"blockquote":["blockquote"],"Give quoted text visual emphasis. \"In quoting others, we cite ourselves.\" \u2014 Julio Cort\u00e1zar":["\u062d\u0648\u0627\u0644\u06c1 \u0645\u062a\u0646 \u0628\u0635\u0631\u06cc \u0632\u0648\u0631 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \"\u062f\u0648\u0633\u0631\u0648\u06ba \u06a9\u06d2 \u062d\u0648\u0627\u0644\u06d2 \u0633\u06d2\u060c \u06c1\u0645 \u062e\u0648\u062f \u06a9\u0627 \u062d\u0648\u0627\u0644\u06c1 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\" \u062c\u0648\u0644\u06cc\u0648 \u06a9\u0627\u0631\u0679\u0631"],"subtitle":["\u0630\u06cc\u0644\u06cc \u0639\u0646\u0648\u0627\u0646"],"title":["\u0639\u0646\u0648\u0627\u0646"],"Introduce new sections and organize content to help visitors (and search engines) understand the structure of your content.":["\u0646\u0626\u06d2 \u062d\u0635\u0648\u06ba \u06a9\u0627 \u062a\u0639\u0627\u0631\u0641 \u0627\u0648\u0631 \u0632\u0627\u0626\u0631\u06cc\u0646 (\u0627\u0648\u0631 \u0633\u0631\u0686 \u0627\u0646\u062c\u0646\u0632) \u06a9\u06cc \u0645\u062f\u062f \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u0648\u0627\u062f \u06a9\u0648 \u0645\u0646\u0638\u0645 \u06a9\u0631\u06cc\u06ba \u0627\u067e\u0646\u06d2 \u0645\u0648\u0627\u062f \u06a9\u06cc \u0633\u0627\u062e\u062a \u06a9\u0648 \u0633\u0645\u062c\u06be\u06cc\u06ba\u06d4"],"Heading":["\u0633\u0631\u062e\u06cc"],"Write heading\u2026":["\u0633\u0631\u062e\u06cc \u0644\u06a9\u06be\u06cc\u06ba\u06d4\u06d4\u06d4"],"Text Alignment":["\u0645\u062a\u0646 \u06a9\u06cc \u0633\u06cc\u062f\u06be"],"Level":["\u0633\u0637\u062d"],"Heading Settings":["\u0633\u0631\u062e\u06cc \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"Heading %d":["%d \u06c1\u06cc\u0688\u0646\u06af"],"photo":["\u062a\u0635\u0648\u06cc\u0631"],"Insert an image to make a visual statement.":["\u0638\u0627\u06c1\u0631\u06cc \u0633\u0679\u06cc\u0679\u0645\u06cc\u0646\u0679 \u06a9\u06d2 \u0644\u06cc\u06d2 \u062a\u0635\u0648\u06cc\u0631 \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06cc\u06ba"],"Write caption\u2026":["\u0639\u0646\u0648\u0627\u0646 \u0644\u06a9\u06be\u06cc\u06ba\u06d4\u06d4\u06d4"],"This image has an empty alt attribute":["\u0627\u0633 \u0627\u0645\u06cc\u062c \u06a9\u0627 \"ALT\" \u0679\u06cc\u06af \u0646\u06c1\u06cc\u06ba \u06c1\u06d2"],"This image has an empty alt attribute; its file name is %s":["\u0627\u0633 \u0627\u0645\u06cc\u062c \u06a9\u0627 \"ALT\" \u0679\u06cc\u06af \u0646\u06c1\u06cc\u06ba \u06c1\u06d2. \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06cc \u0641\u0627\u0626\u0644 \u06a9\u0627 \u0646\u0627\u0645 %s \u06c1\u06d2"],"Open in New Tab":["\u0646\u0626\u06d2 \u0679\u06cc\u0628 \u0645\u06cc\u06ba \u06a9\u06be\u0648\u0644\u06cc\u06ba"],"Link URL":["\u062d\u0648\u0627\u0644\u06c1 \u062c\u0627\u062a\u06cc \u0644\u0646\u06a9"],"Image Dimensions":["\u062a\u0635\u0648\u06cc\u0631\u06a9\u06cc \u0637\u0648\u0644 \u0648 \u0639\u0631\u0636"],"Alternative text describes your image to people who can\u2019t see it. Add a short description with its key details.":["\u0627\u0653\u0644\u0679\u0631\u0646\u06cc\u0679 \u0679\u06cc\u06a9\u0633\u0679 \u0627\u0653\u067e \u06a9\u06cc \u062a\u0635\u0648\u06cc\u0631 \u0628\u06cc\u0627\u0646 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u06cc\u06c1 \u0627\u0646 \u0644\u0648\u06af\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2 \u062c\u0648 \u062a\u0635\u0648\u06cc\u0631 \u0646\u06c1\u06cc\u06ba \u062f\u06cc\u06a9\u06be \u0633\u06a9\u062a\u06d2\u06d4 \u0627\u06cc\u06a9 \u0645\u062e\u062a\u0635\u0631 \u0633\u06cc \u062a\u0641\u0635\u06cc\u0644 \u0644\u06a9\u06be\u06cc\u06ba\u06d4"],"Alt Text (Alternative Text)":["Alt Text ( \u0645\u062a\u0628\u0627\u062f\u0644 \u0679\u06cc\u06a9\u0633\u0679)"],"Image Settings":["\u062a\u0635\u0648\u06cc\u0631\u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a"],"Edit image":["\u062a\u0635\u0648\u06cc\u0631 \u0645\u06cc\u06ba \u062a\u0631\u0645\u06cc\u0645 \u06a9\u0631\u06cc\u06ba"],"Embed a WordPress.tv video.":["WordPress.tv \u0648\u06cc\u0688\u06cc\u0648\u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed a VideoPress video.":["VideoPress \u0648\u06cc\u0688\u06cc\u0648\u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed a Tumblr post.":["\u0679\u0645\u0628\u0644\u0631 \u067e\u0648\u0633\u0679 \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed a TED video.":["TED \u0648\u06cc\u0688\u06cc\u0648\u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Speaker Deck content.":["\u0627\u0633\u067e\u06cc\u06a9\u0631 \u0688\u06cc\u06a9 \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed SmugMug content.":["SmugMug \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Slideshare content.":["\u0633\u0644\u0627\u0626\u06cc\u0688 \u0634\u06cc\u0626\u0631 \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Scribd content.":["Scribd \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Screencast content.":["\u0627\u0633\u06a9\u0631\u06cc\u0646 \u0634\u0627\u0631\u0679 \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed ReverbNation content.":["ReverbNation \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed a Reddit thread.":["Reddit \u062a\u06be\u0631\u06cc\u0688 \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Polldaddy content.":["\u067e\u0648\u0644 \u0688\u06cc\u0688\u06cc \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed a Photobucket image.":["\u0641\u0648\u0679\u0648 \u0628\u06a9\u0679 \u062a\u0635\u0648\u06cc\u0631 \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Mixcloud content.":["Mixcloud \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Meetup.com content.":["Meetup.com \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Kickstarter content.":["Kickstarter \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Issuu content.":["Issuu \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Imgur content.":["Imgur \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Hulu content.":["Hulu \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Funny or Die content.":["Funny or Die \u0645\u0648\u0627\u062f \u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed a Dailymotion video.":["Dailymotion \u0648\u06cc\u0688\u06cc\u0648\u0627\u06cc\u0645\u0628\u06cc\u0688 \u06a9\u0631\u06cc\u06ba\u06d4"],"Embed Cr